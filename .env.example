# API auth. Empty means development mode without auth.
CARINA_API_KEY=change-me

# Demo webhook secret (optional). When set, callers must send x-carina-secret.
DEMO_WEBHOOK_SECRET=

# GitHub source (optional)
GITHUB_REPOSITORY=owner/repo
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Worker runtime: stub runs the full chain without a model; dsh uses DSH SDK sessions.
# Keep both values on the same runtime.
WORKER_RUNTIME=stub
DSH_RUNTIME=stub
DSH_PROVIDER=deepseek-official
DSH_MODEL=deepseek-v4-flash
DSH_ROUTER_MODEL=
DSH_WORKER_MODEL=
DSH_MAX_TOKENS=49152
DSH_HOME=/root/.dsh
# Comma-separated absolute paths to DSH profile patch files.
DSH_PATCHES=
WORKER_ROLE=all

# Model credentials for DSH when DSH_RUNTIME=dsh.
DEEPSEEK_API_KEY=
